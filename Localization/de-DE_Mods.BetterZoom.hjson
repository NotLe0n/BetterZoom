Configs: {
	Config: {
		DisplayName: Einstellungen

		scaleBackground: {
			Tooltip: Bestimmt ob der Hintergrund auch zoomen soll.
			Label: Hintergrund skalieren
		}

		cursorScale: {
			Tooltip: Ändert die größe des Zeigers.
			Label: Zeigergröße
		}

		zoomRange: {
			Label: Zoom Wertebereich
			Tooltip: Ändert den maximalen und minimalen Zoom Wert den du setzen kannst.
		}

		UIScaleRange: {
			Label: UI-Skala Wertebereich
			Tooltip: Ändert den maximalen UI-Skala Wert den du setzen kannst.
		}

		disableUIZoomHotkey: {
			Label: UI Zoom Hotkey ausschalten
			Tooltip: Schaltet den Shift+Plus/Shift+Minus Hotkey für den UI Zoom aus
		}

		renderMoreTiles: {
			Label: Zeige mehr Blöcke
			Tooltip:
				'''
				Wenn man diese Option anschaltet, zeichnet das Spiel mehr Blöcke auf dem Bildschirm.
				Achtung: Je weiter man raus zoomt, desto laggier wird das Spiel. Dagegen kann ich nichts machen.
				'''
		}
	}

	FloatRange: {
		// Tooltip: ""

		min: {
			// Label: min
			// Tooltip: ""
		}

		max: {
			// Label: max
			// Tooltip: ""
		}
	}
}

Settings: {
	Reset.Tooltip: Klicken, um auf 100% zurückzusetzen.

	InputToggle: {
		Slider.Tooltip: Schieberegler

Configs: {
	Config: {
		DisplayName: Config

		scaleBackground: {
			Tooltip: This toggles if the background should zoom too
			Label: Scale Background
		}

		cursorScale: {
			Tooltip: This changes the size of your cursor
			Label: Cursor Scale
		}

		maxZoom: {
			Tooltip:
				'''
				This changes the maximal amount of zoom you can set
				You need to set this in the mod menu, since it requires a reload
				'''
			Label: Max Zoom
		}

		minZoom: {
			Tooltip:
				'''
				This changes the minimum amount of zoom you can set
				You need to set this in the mod menu, since it requires a reload
				'''
			Label: Min Zoom
		}

		minUIScale: {
			Tooltip:
				'''
				This changes the minimum amount of UI scale you can set
				You need to set this in the mod menu, since it requires a reload
				'''
			Label: Min UI Scale
		}

		maxUIScale: {
			Tooltip:
				'''
				This changes the maximal amount of UI scale you can set
				You need to set this in the mod menu, since it requires a reload
				'''
			Label: Max UI Scale
		}

		disableUIZoomHotkey: {
			Label: Disable UI Zoom Hotkey
			Tooltip: Disables the Shift+Plus/Shift+Minus Hotkey to change the UI zoom
		}

		renderMoreTiles: {
			Label: Render more tiles
			Tooltip:
				'''
				Turning this on renders more tiles outside the normal view range.
				Note: This will make the game noticeably laggier the more you zoom out. I can't do anything about that.
				'''
		}

		tiles: {
			Label: tiles
			Tooltip: ""
		}
	}
}

Settings: {
	Reset.Tooltip: Click to reset to 100%

	InputToggle: {
		Slider.Tooltip: Slider
		Precise.Tooltip: Precise Input
	}
}

Configs: {
	Config: {
		DisplayName: Конфигурация

		scaleBackground: {
			Tooltip: Определяет, должен ли фон также увеличиваться.
			Label: Масштабный фон
		}

		cursorScale: {
			Tooltip: Изменяет размер курсора.
			Label: Масштаб курсора
		}

		zoomRange: {
			Label: Диапазон масштабирования
			Tooltip: Это изменяет максимальную и минимальную величину зума, которую вы можете установить
		}

		UIScaleRange: {
			Label: Диапазон шкалы пользовательского интерфейса
			Tooltip: Это изменяет минимальную и максимальную величину масштаба пользовательского интерфейса, которую вы можете установить
		}

		disableUIZoomHotkey: {
			Label: Отключить сочетание клавиш масштабирования интерфейса
			Tooltip: Отключает сочетание клавиш Shift+Плюс/Shift+Минус для изменения масштаба интерфейса
		}

		renderMoreTiles: {
			Label: Показать больше блоков
			Tooltip:
				'''
				Включение этой опции покажет больше блоков за пределами обычного диапазона просмотра.
				            Примечание: это сделает игру заметно более медленной, чем больше вы уменьшаете масштаб. Я ничего не могу с этим поделать.
				            
				'''
		}

		tileRenderLimit: {
			Label: ограничение рендеринга блока
			Tooltip:
				'''
				Этот параметр определяет уровень масштабирования, при котором блоки все еще видны. Чем меньше число, тем медленнее игра, но тем больше блоков вы видите. 
				            Например: если установить этот параметр на 0,5 (50%), вы все равно сможете видеть блоки при увеличении до 50%.
				'''
		}
	}

	FloatRange: {
		// Tooltip: ""

		min: {
			// Label: min
			// Tooltip: ""
		}

		max: {
			// Label: max
			// Tooltip: ""
		}
	}
}

Settings: {
	Reset.Tooltip: Нажмите, чтобы сбросить до 100%.

	InputToggle: {
		Slider.Tooltip: Слайдер
		Precise.Tooltip: Точный ввод
	}
}

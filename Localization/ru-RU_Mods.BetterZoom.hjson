Configs: {
	Config: {
		DisplayName: Конфигурация

		scaleBackground: {
			Tooltip: Определяет, должен ли фон также увеличиваться.
			Label: Масштабирование фона
		}

		cursorScale: {
			Tooltip: Изменяет размер курсора.
			Label: Масштаб курсора
		}

		zoomRange: {
			Label: Диапазон масштабирования
			Tooltip: Изменяет минимальную и максимальную величину зума, которую вы можете установить.
		}

		UIScaleRange: {
			Label: Диапазон масштаба интерфейса
			Tooltip: Изменяет минимальную и максимальную величину масштаба интерфейса, которую вы можете установить.
		}

		disableUIZoomHotkey: {
			Label: Отключить сочетание клавиш масштабирования интерфейса
			Tooltip: Отключает сочетание клавиш Shift+Плюс/Shift+Минус для изменения масштаба интерфейса.
		}

		renderMoreTiles: {
			Label: Отрисовывать больше блоков
			Tooltip:
				'''
				Включение этой опции покажет больше блоков за пределами обычного диапазона просмотра.
				Примечание: это заметно замедлит игру, чем больше вы уменьшаете масштаб. Я ничего не могу с этим поделать.
				'''
		}

		tileRenderLimit: {
			Label: Ограничение отрисовки блоков
			Tooltip:
				'''
				Этот параметр определяет уровень масштабирования, при котором блоки всё ещё видны. Чем меньше число, тем медленнее игра, но тем больше блоков вы видите.
				Например: если установить этот параметр на 0,5 (50%), вы всё равно сможете видеть блоки при увеличении до 50%.
				'''
		}

		zoomSpeed: {
			Label: Скорость зума
			Tooltip: Изменяет скорость масштабирования с помощью клавиатуры. 1 — значение по умолчанию, 10 — в 10 раз быстрее.
		}
	}

	FloatRange: {
		// Tooltip: ""

		min: {
			// Label: min
			// Tooltip: ""
		}

		max: {
			// Label: max
			// Tooltip: ""
		}
	}
}

Settings: {
	Reset.Tooltip: Нажмите, чтобы сбросить до 100%.

	InputToggle: {
		Slider.Tooltip: Ползунок
		Precise.Tooltip: Точный ввод
	}
}

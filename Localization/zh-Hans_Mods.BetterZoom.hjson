Configs: {
	Config: {
		DisplayName: 配置

		scaleBackground: {
			Tooltip: 该配置用来觉得背景是否被缩放
			Label: 背景比例
		}

		cursorScale: {
			Tooltip: 该配置用来更改你的光标比例
			Label: 光标比例
		}

		zoomRange: {
			Label: 缩放比例
			Tooltip: 该配置用来更改可设置的缩放最小值和最大值
		}

		UIScaleRange: {
			Label: UI比例
			Tooltip: 该配置用了更改可设置的UI比例最小值和最大值
		}

		disableUIZoomHotkey: {
			Label: 禁用UI比例快捷键
			Tooltip: 禁用Shift & +/Shift & -两个更改UI比例的快捷键
		}

		renderMoreTiles: {
			Label: 渲染更多物块
			Tooltip:
				'''
				启用该选项以渲染更多超出视野范围内的物块
				注意：
				     这会使得你过分放大你的视野后造成游戏卡顿
				     我对此无能为力
				'''
		}

		tileRenderLimit: {
			Label: 物块渲染限制
			Tooltip:
				'''
				这会设置在哪个缩放级别下可以看到更多的物块
				越低，游戏越卡，你能看到的物块越多
				（代码逻辑如此）
				例如，你设置了0.5（即50%）
				那么你只能看到视野范围内50%的物块
				'''
		}
	}

	FloatRange: {
		Tooltip: ""

		min: {
			Label: 最小值
			Tooltip: ""
		}

		max: {
			Label: 最大值
			Tooltip: ""
		}
	}
}

Settings: {
	Reset.Tooltip: 点击以重设为100%

	InputToggle: {
		Slider.Tooltip: 滑块
		Precise.Tooltip: 准确数值
	}
}
